{
  "format": "astral.actions",
  "version": 1,
  "actions": {
    "move": {
      "type": "axis2",
      "x": { "negative": ["A"], "positive": ["D"] },
      "y": { "negative": ["S"], "positive": ["W"] },
      "stick": "left"
    },
    "turn": { "type": "axis", "negative": ["Right"], "positive": ["Left"], "gamepad_axis": "RightX" },
    "jump": { "type": "button", "keys": ["Space"], "gamepad": ["A"] },
    "toggle_fly": { "type": "button", "keys": ["F"], "gamepad": ["Y"] }
  }
}
