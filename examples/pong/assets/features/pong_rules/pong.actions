{
  "format": "astral.actions",
  "version": 1,
  "actions": {
    "move": {
      "type": "axis2",
      "x": { "negative": ["A", "Left"], "positive": ["D", "Right"] },
      "y": { "negative": ["S", "Down"], "positive": ["W", "Up"] },
      "stick": "left",
      "dpad": true
    },
    "aim": { "type": "axis2", "stick": "right" },
    "look": { "type": "axis2", "mouse_delta": [0.012, -0.012] },
    "save_match": { "type": "button", "keys": ["F5"], "gamepad": ["LeftShoulder"] },
    "load_match": { "type": "button", "keys": ["F9"], "gamepad": ["RightShoulder"] }
  }
}
