// Water seen from above: blue, mostly clear near the viewer, brighter towards the horizon; the surface ripples with TIME.
shader_type surface;
render_mode blend_mix;

uniform vec3 tint : source_color = vec3(0.05, 0.30, 0.45);
uniform float opacity : range(0.0, 1.0, 0.01) = 0.55;

void surface() {
    float ripple = 0.5 + 0.5 * sin(WORLD_POSITION.x * 1.7 + TIME * 1.3) * sin(WORLD_POSITION.z * 1.3 - TIME * 0.9);
    float f = pow(1.0 - clamp(dot(NORMAL, VIEW_DIR), 0.0, 1.0), 2.5);
    ALBEDO = tint * (0.7 + 0.3 * ripple);
    ROUGHNESS = 0.06;
    METALLIC = 0.0;
    ALPHA = clamp(opacity + f * (1.0 - opacity), 0.0, 1.0);
    EMISSION = tint * f * 0.4;
}
