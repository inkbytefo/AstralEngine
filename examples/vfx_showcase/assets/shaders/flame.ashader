shader_type volume;
uniform vec3 hot_color = vec3(8.0, 1.8, 0.22);
void volume() {
    float height = UVW.y;
    vec2 lean = vec2(sin(height * 7.0 - TIME * 13.0), cos(height * 6.0 - TIME * 11.0)) * height * 0.11;
    float radius = length(UVW.xz - 0.5 - lean);
    float thickness = 0.32 * (1.0 - height);
    float envelope = (1.0 - smoothstep(thickness * 0.32, max(thickness, 0.001), radius))
        * smoothstep(0.03, 0.19, height) * (1.0 - smoothstep(0.55, 0.91, height));
    float lifetime = smoothstep(0.0, 0.12, AGE) * (1.0 - smoothstep(1.6, 2.3, AGE));
    DENSITY = envelope * lifetime * 0.18;
    EMISSION = hot_color * envelope * lifetime * (1.0 - 0.65 * height);
}
