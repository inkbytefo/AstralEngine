shader_type particle;
render_mode blend_mix;
uniform vec3 ember_glow = vec3(1.6, 0.45, 0.08);
void motion() {
    float t = clamp(AGE / max(LIFETIME, 0.001), 0.0, 1.0);
    float swirl = RANDOM * 6.28318 + AGE * 3.2;
    WORLD_POSITION.x += cos(swirl) * 0.18 * t;
    WORLD_POSITION.z += sin(swirl) * 0.18 * t;
    WORLD_POSITION.y += AGE * (0.9 + RANDOM * 1.1);
    SIZE *= mix(0.85, 1.35, t);
}
void particle() {
    float fade = smoothstep(0.0, 0.12, AGE) * (1.0 - smoothstep(0.6, 1.3, AGE));
    COLOR = mix(COLOR, ember_glow, 0.55);
    ALPHA *= fade * 0.85;
}
