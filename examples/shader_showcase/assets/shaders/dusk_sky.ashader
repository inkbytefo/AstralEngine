// The sky: a gradient from a warm horizon to a deep zenith, a dark ground, and the sun's disc and halo.
shader_type sky;

uniform vec3 zenith : source_color = vec3(0.04, 0.07, 0.28);
uniform vec3 horizon : source_color = vec3(1.00, 0.45, 0.20);
uniform vec3 ground_color : source_color = vec3(0.05, 0.04, 0.05);

void sky() {
    float h = EYEDIR.y;
    vec3 c = mix(horizon, zenith, pow(clamp(h, 0.0, 1.0), 0.5));
    c = mix(c, ground_color, smoothstep(0.0, -0.12, h));
    float s = max(dot(EYEDIR, SUN_DIR), 0.0);
    c += SUN_COLOR * (pow(s, 700.0) * 25.0 + pow(s, 10.0) * 0.5);
    COLOR = c;
}
