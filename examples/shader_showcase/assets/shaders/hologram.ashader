// A projection with moving traces, interrupted scan lines and bright frame corners.
shader_type surface;
render_mode blend_add, cull_disabled;

uniform vec3 trace_color : source_color = vec3(0.035, 0.68, 1.0);
uniform vec3 accent_color : source_color = vec3(0.59, 0.19, 1.0);
uniform float scan_speed : range(0.0, 4.0, 0.05) = 0.62;

void surface() {
    vec2 margins = min(UV, 1.0 - UV);
    float border = 1.0 - smoothstep(0.012, 0.052, min(margins.x, margins.y));
    float corners = border * (1.0 - smoothstep(0.13, 0.28, max(margins.x, margins.y)));

    vec2 panel = UV * vec2(11.0, 15.0);
    vec2 cell = floor(panel);
    float signal = fract(cell.x * 0.231 + cell.y * 0.317 + floor(TIME * 3.0) * 0.173);
    float trace = (1.0 - smoothstep(0.09, 0.21, abs(fract(panel.y) - 0.5))) * step(0.46, signal);
    float sweep = exp(-11.0 * abs(fract(WORLD_POSITION.y * 0.63 - TIME * scan_speed) - 0.5));
    float edge = pow(1.0 - abs(dot(NORMAL, VIEW_DIR)), 2.0);
    float scan = 0.62 + 0.38 * cos(WORLD_POSITION.y * 112.0 - TIME * 9.0);

    ALBEDO = vec3(0.0);
    EMISSION = trace_color * (0.08 + 0.23 * trace + 0.49 * border + 0.57 * sweep) * scan
             + accent_color * (0.43 * corners + 0.15 * edge);
    ALPHA = 0.23 + 0.31 * corners + 0.24 * sweep;
}
