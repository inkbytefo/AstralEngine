// World-space paving. Inlaid conductors guide the eye toward the five exhibits.
shader_type surface;

uniform vec3 tile_color : source_color = vec3(0.072, 0.086, 0.13);
uniform vec3 inlay_color : source_color = vec3(0.075, 0.63, 0.72);
uniform float reflectivity : range(0.0, 1.0, 0.01) = 0.74;

void surface() {
    vec2 tile = WORLD_POSITION.xz * vec2(0.8, 0.66);
    tile.x += 0.5 * mod(floor(tile.y), 2.0);
    vec2 margin = min(fract(tile), 1.0 - fract(tile));
    float seam = 1.0 - smoothstep(0.013, 0.034, min(margin.x, margin.y));
    float panel = 0.88 + 0.12 * cos(dot(floor(tile), vec2(1.71, 3.11)));
    float rails = 1.0 - smoothstep(0.018, 0.05, abs(abs(WORLD_POSITION.z - 0.28) - 1.87));
    float marker = 1.0 - smoothstep(0.04, 0.21, abs(fract(WORLD_POSITION.x * 0.8) - 0.5));
    float range_fade = 1.0 - smoothstep(5.1, 6.9, abs(WORLD_POSITION.x));

    ALBEDO = tile_color * panel * (1.0 - seam * 0.63);
    METALLIC = reflectivity * (1.0 - seam * 0.58);
    ROUGHNESS = 0.22 + 0.42 * seam;
    EMISSION = inlay_color * rails * range_fade * (0.12 + marker * 0.78);
}
