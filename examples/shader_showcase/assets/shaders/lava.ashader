// Three-dimensional noise keeps the molten network continuous across the sphere's UV seam.
shader_type surface;

uniform vec3 melt_color : source_color = vec3(1.0, 0.17, 0.025);
uniform vec3 core_color : source_color = vec3(1.0, 0.72, 0.14);
uniform vec3 basalt_color : source_color = vec3(0.085, 0.035, 0.028);
uniform float flow_speed : range(0.0, 1.5, 0.01) = 0.19;
uniform float heat : range(0.0, 8.0, 0.1) = 2.8;

float lava_hash(vec3 cell) {
    cell = fract(cell * vec3(0.1031, 0.11369, 0.13787));
    cell += dot(cell, cell.yzx + 19.19);
    return fract((cell.x + cell.y) * cell.z);
}

float lava_noise(vec3 point) {
    vec3 cell = floor(point);
    vec3 blend = smoothstep(vec3(0.0), vec3(1.0), fract(point));
    vec4 low = vec4(lava_hash(cell), lava_hash(cell + vec3(1, 0, 0)),
                   lava_hash(cell + vec3(0, 1, 0)), lava_hash(cell + vec3(1, 1, 0)));
    vec4 high = vec4(lava_hash(cell + vec3(0, 0, 1)), lava_hash(cell + vec3(1, 0, 1)),
                    lava_hash(cell + vec3(0, 1, 1)), lava_hash(cell + vec3(1, 1, 1)));
    vec4 plane = mix(low, high, blend.z);
    return mix(mix(plane.x, plane.y, blend.x), mix(plane.z, plane.w, blend.x), blend.y);
}

void surface() {
    vec2 angles = UV * vec2(6.283185, 3.141593);
    float latitude = sin(angles.y);
    vec3 sphere = vec3(latitude * cos(angles.x), cos(angles.y), -latitude * sin(angles.x));
    vec3 flow = sphere * 3.8 + vec3(0.28, 1.0, -0.42) * TIME * flow_speed + vec3(4.0);
    float warp = lava_noise(flow * 1.7);
    float field = lava_noise(flow + warp * 0.82) + 0.12 * lava_noise(flow * 3.1);
    float seam = abs(field - 0.50);
    float hot_channel = 1.0 - smoothstep(0.025, 0.14, seam);
    float core = 1.0 - smoothstep(0.005, 0.048, seam);
    float pores = lava_noise(sphere * 34.0 + vec3(8.0));

    ALBEDO = mix(basalt_color * (0.65 + pores * 0.68), melt_color * 0.29, hot_channel);
    ROUGHNESS = mix(0.93, 0.32, hot_channel);
    AO = 0.78 + 0.22 * pores;
    EMISSION = (melt_color * hot_channel * 0.72 + core_color * core * 0.64) * heat;
}
