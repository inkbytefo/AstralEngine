// Flowing lava: two layers of fractal noise drift over the surface; the dark crust breaks into glowing
// cracks. TIME drives the flow, so it needs nothing but the shader.
shader_type surface;

uniform vec3 hot : source_color = vec3(1.0, 0.32, 0.04);
uniform vec3 crust : source_color = vec3(0.035, 0.018, 0.012);
uniform float flow_speed : range(0.0, 2.0, 0.01) = 0.30;
uniform float intensity : range(0.0, 12.0, 0.1) = 1.5;
uniform float scale : range(1.0, 20.0, 0.1) = 5.0;

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }

float value_noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0));
    float d = hash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float fbm(vec2 p) {
    float amplitude = 0.5;
    float sum = 0.0;
    for (int i = 0; i < 4; i++) {
        sum += amplitude * value_noise(p);
        p *= 2.03;
        amplitude *= 0.5;
    }
    return sum;
}

void surface() {
    vec2 p = UV * scale + vec2(TIME * flow_speed, TIME * flow_speed * 0.6);
    float n = fbm(p + fbm(p * 1.7 - TIME * flow_speed * 0.5));
    float crust_mask = smoothstep(0.38, 0.55, n);
    float glow = 1.0 - crust_mask;
    ALBEDO = mix(crust, hot * 0.25, glow * 0.4);
    ROUGHNESS = 0.9;
    EMISSION = hot * glow * glow * intensity;
}
