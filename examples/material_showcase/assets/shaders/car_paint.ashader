shader_type surface;
shading_model clearcoat;

uniform vec4 base_tint : source_color = vec4(0.62, 0.03, 0.05, 1.0);
uniform float coat_strength : range(0.0, 1.0) = 1.0;
uniform float coat_roughness : range(0.02, 0.5) = 0.04;

void surface() {
    ALBEDO = base_tint.rgb;
    ROUGHNESS = 0.45;
    METALLIC = 0.2;
    CLEARCOAT = coat_strength;
    CLEARCOAT_ROUGHNESS = coat_roughness;
}
