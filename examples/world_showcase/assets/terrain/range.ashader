shader_type surface;

// The engine's .aterrain format stores height tiles only (no splatmap/layer data yet),
// so terrain surface layers are computed here from world height and surface slope:
// sand in the basin, meadow grass on mid slopes, bare rock on steeper ridges, snow on the high peak.
void surface() {
    float h = WORLD_POSITION.y;
    float level = smoothstep(0.92, 0.985, NORMAL.y);
    vec3 sand = vec3(0.58, 0.49, 0.31);
    vec3 grass = vec3(0.16, 0.30, 0.09);
    vec3 rock = vec3(0.30, 0.27, 0.25);
    vec3 snow = vec3(0.86, 0.89, 0.93);
    vec3 lowland = mix(sand, grass, smoothstep(20.0, 29.0, h));
    vec3 ground = mix(rock, lowland, level);
    float snow_line = smoothstep(52.0, 62.0, h + 4.0 * sin(UV.x * 0.07) * cos(UV.y * 0.05));
    float variation = 0.92 + 0.08 * sin(UV.x * 0.35) * cos(UV.y * 0.29);
    ALBEDO = mix(ground, snow, snow_line * smoothstep(0.84, 0.96, NORMAL.y)) * variation;
    ROUGHNESS = mix(0.95, 0.6, snow_line);
}
