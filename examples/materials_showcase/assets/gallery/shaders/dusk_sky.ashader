// Night sky with a procedural ridgeline and two moving aurora curtains.
shader_type sky;

uniform vec3 zenith : source_color = vec3(0.008, 0.014, 0.062);
uniform vec3 horizon : source_color = vec3(0.105, 0.062, 0.16);
uniform vec3 aurora_color : source_color = vec3(0.025, 0.53, 0.35);
uniform float aurora_strength : range(0.0, 2.0, 0.05) = 0.82;

float sky_hash(vec2 cell) {
    vec3 seed = fract(vec3(cell.xyx) * vec3(0.1031, 0.1030, 0.0973));
    seed += dot(seed, seed.yzx + 33.33);
    return fract((seed.x + seed.y) * seed.z);
}

void sky() {
    float h = EYEDIR.y;
    float longitude = atan(EYEDIR.x, -EYEDIR.z);
    float skyline = -0.022 + 0.033 * sin(longitude * 3.0 + 1.6)
                   + 0.017 * sin(longitude * 11.0) + 0.006 * sin(longitude * 29.0 + 1.3);
    vec3 gradient = mix(horizon, zenith, smoothstep(-0.015, 0.42, h));
    float haze = exp(-17.0 * abs(h - 0.02));
    gradient += vec3(0.046, 0.024, 0.075) * haze;

    vec2 star_grid = vec2(longitude * 42.0, h * 110.0);
    vec2 cell = floor(star_grid);
    float seed = sky_hash(cell);
    vec2 offset = vec2(sky_hash(cell + 13.0), sky_hash(cell - 17.0)) * 0.54 + 0.23;
    float star = (1.0 - smoothstep(0.035, 0.21, length(fract(star_grid) - offset)));
    gradient += vec3(0.35, 0.49, 0.73) * star * smoothstep(0.89, 1.0, seed) * smoothstep(0.04, 0.2, h);

    float crest = 0.24 + 0.085 * sin(longitude * 4.0 + TIME * 0.13) + 0.045 * sin(longitude * 9.0);
    float height = h - crest;
    float curtain = exp(-abs(height) * 22.0) * smoothstep(-0.032, 0.022, height);
    float folds = 0.46 + 0.54 * pow(0.5 + 0.5 * sin(longitude * 31.0 + height * 18.0), 2.0);
    float veil = exp(-abs(height - 0.073 + 0.04 * sin(longitude * 8.0 - TIME * 0.1)) * 15.0);
    gradient += (aurora_color * curtain * folds + vec3(0.19, 0.055, 0.31) * veil * 0.26) * aurora_strength;

    float moon_distance = length(EYEDIR - SUN_DIR);
    float disc = 1.0 - smoothstep(0.022, 0.025, moon_distance);
    vec3 shadow_direction = normalize(SUN_DIR + vec3(-0.011, 0.006, 0.0));
    float shadow = 1.0 - smoothstep(0.019, 0.023, length(EYEDIR - shadow_direction));
    float crescent = disc * (1.0 - shadow);
    gradient += vec3(0.67, 0.83, 1.0) * (crescent * 1.7 + exp(-moon_distance * 11.0) * 0.19);
    COLOR = mix(vec3(0.010, 0.011, 0.022), gradient, smoothstep(skyline - 0.005, skyline + 0.004, h));
}
