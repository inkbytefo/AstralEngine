shader_type surface;
render_mode unshaded;

uniform float checker_tiles : range(1.0, 128.0) = 8.0;
uniform bool second_uv = false;
uniform bool show_density = false;
uniform float reference_resolution = 1024.0;
uniform float target_texels_per_meter = 512.0;

void surface() {
    vec2 uv = second_uv ? UV1 : UV;
    vec2 cell = floor(uv * checker_tiles);
    float check = mod(cell.x + cell.y, 2.0);
    vec3 color = mix(vec3(0.075), vec3(0.83), check);
    if (show_density) {
        float world_area = length(cross(dFdx(WORLD_POSITION), dFdy(WORLD_POSITION)));
        vec2 dx = dFdx(uv), dy = dFdy(uv);
        float uv_area = abs(dx.x * dy.y - dx.y * dy.x);
        if (world_area > 1e-10) {
            float density = reference_resolution * sqrt(uv_area / world_area);
            float ratio = density / max(target_texels_per_meter, 1.0);
            color = ratio < 1.0 ? mix(vec3(0.1, 0.25, 1.0), vec3(0.1, 1.0, 0.35), ratio)
                                : mix(vec3(0.1, 1.0, 0.35), vec3(1.0, 0.21, 0.08), clamp(ratio - 1.0, 0.0, 1.0));
        }
    }
    ALBEDO = color;
}
