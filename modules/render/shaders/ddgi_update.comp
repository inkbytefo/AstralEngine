#version 460
#include <astral/rt.glsl>
// Blends this frame's probe rays into the octahedral atlases (one invocation per atlas texel,
// borders included). mode 0: irradiance (cosine weights), 1: distance moments (sharp weights).
layout(push_constant, scalar) uniform Push {
    FrameRef frame; ProbeRays rays; uint prev; uint out_tex; uint mode;
} pc;
layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    Frame f = pc.frame.f;
    int interior = pc.mode == 0u ? DDGI_IRR : DDGI_DIST;
    int tile = interior + 2;
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ddgi_atlas_size(f, interior);
    if (texel.x >= size.x || texel.y >= size.y) return;
    ivec2 tile_xy = texel / tile;
    uint probe = uint(tile_xy.x) + uint(tile_xy.y) * f.ddgi_counts.x * f.ddgi_counts.y;
    ivec2 local = texel - tile_xy * tile;

    // Border texels repeat the interior texel across the octahedral seam.
    int last = tile - 1;
    ivec2 src = local;
    bool bx = local.x == 0 || local.x == last, by = local.y == 0 || local.y == last;
    if (bx && by) {
        src = ivec2(local.x == 0 ? last - 1 : 1, local.y == 0 ? last - 1 : 1);
    } else if (bx) {
        src = ivec2(local.x == 0 ? 1 : last - 1, last - local.y);
    } else if (by) {
        src = ivec2(last - local.x, local.y == 0 ? 1 : last - 1);
    }
    vec2 oct = (vec2(src - 1) + 0.5) / float(interior) * 2.0 - 1.0;
    vec3 texel_dir = oct_decode(oct);

    uint rays = f.ddgi_counts.w;
    mat3 rotation = ddgi_rotation(f.rt_counts.y);
    vec4 sum = vec4(0);
    float max_dist = 1.5 * length(f.ddgi_spacing.xyz);
    for (uint r = 0u; r < rays; ++r) {
        vec4 data = pc.rays.data[probe * rays + r];
        vec3 dir = ddgi_ray_dir(r, rays, rotation);
        float c = max(dot(texel_dir, dir), 0.0);
        if (pc.mode == 0u) {
            sum += vec4(data.rgb * c, c);
        } else {
            float w = pow(c, 50.0);
            float d = min(data.a, max_dist);
            sum += vec4(d * w, d * d * w, 0, w);
        }
    }
    vec4 result = sum.w > 1e-5 ? vec4(sum.xyz / sum.w, 1) : vec4(0);
    if (f.rt_counts.w != 0u) {
        vec2 uv = (vec2(texel) + 0.5) / vec2(size);
        vec4 previous = astral_sample(pc.prev, ASTRAL_SAMPLER_NEAREST_CLAMP, uv);
        if (sum.w <= 1e-5) result = previous;
        else result = vec4(mix(result.rgb, previous.rgb, f.ddgi_origin.w), 1);
    }
    imageStore(astral_storage_images[pc.out_tex], texel, result);
}
