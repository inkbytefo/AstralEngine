#version 460
#include <astral/scene.glsl>
layout(local_size_x = 8, local_size_y = 8) in;
struct SmokeVolume {
    vec3 corner;
    float cell_size;
    float extinction;
    uint side, first_word, modulation;
};
ASTRAL_BUFFER(SmokeVolumes, SmokeVolume);
ASTRAL_BUFFER(SmokeWords, uint);

layout(push_constant, scalar) uniform Push {
    FrameRef frame;
    SmokeVolumes volumes;
    SmokeWords words;
    uint atlas, shadow, width, height, count;
} pc;

vec4 occupied_length(SmokeVolume v, vec3 eye, vec3 ray, float enter, float exit) {
    vec3 origin = (eye - v.corner) / v.cell_size;
    vec3 dir = ray / v.cell_size;
    for (int a = 0; a < 3; ++a) {
        if (abs(dir[a]) < 1e-8) {
            if (origin[a] < 0.0 || origin[a] >= float(v.side)) return vec4(0.0);
        } else {
            float t0 = -origin[a] / dir[a];
            float t1 = (float(v.side) - origin[a]) / dir[a];
            enter = max(enter, min(t0, t1));
            exit = min(exit, max(t0, t1));
        }
    }
    if (enter >= exit) return vec4(0.0);

    vec3 p = clamp(origin + dir * enter, vec3(0), vec3(v.side));
    ivec3 step_dir = ivec3(greaterThanEqual(dir, vec3(0))) * 2 - 1;
    ivec3 cell = clamp(ivec3(mix(ceil(p) - 1.0, floor(p), greaterThanEqual(dir, vec3(0)))),
                       ivec3(0), ivec3(v.side - 1u));
    vec3 edge = vec3(1e30);
    for (int a = 0; a < 3; ++a) {
        if (abs(dir[a]) >= 1e-8) edge[a] = (float(cell[a] + (step_dir[a] > 0 ? 1 : 0)) - origin[a]) / dir[a];
    }
    vec4 filled = vec4(0.0);
    for (uint i = 0u; i < v.side * 3u && enter < exit; ++i) {
        float next = min(exit, min(edge.x, min(edge.y, edge.z)));
        uint index = (uint(cell.z) * v.side + uint(cell.y)) * v.side + uint(cell.x);
        uint word = pc.words.data[v.first_word + index / 32u];
        if ((word & (1u << (index % 32u))) != 0u) {
            vec4 material = v.modulation == NO_TEXTURE ? vec4(1) :
                texelFetch(sampler2D(astral_textures[nonuniformEXT(v.modulation)], astral_samplers[ASTRAL_SAMPLER_NEAREST_CLAMP]),
                           ivec2(cell.x, cell.y + cell.z * int(v.side)), 0);
            filled += vec4(material.rgb, 1) * (material.a * max(0.0, next - enter));
        }
        if (next >= exit) break;
        for (int a = 0; a < 3; ++a) {
            if (edge[a] > next) continue;
            cell[a] += step_dir[a];
            if (cell[a] < 0 || cell[a] >= int(v.side)) return filled;
            edge[a] += 1.0 / abs(dir[a]);
        }
        enter = next;
    }
    return filled;
}

float sun_visibility(Frame f, vec3 p) {
    if (pc.shadow == NO_TEXTURE) return 1.0;
    vec4 clip = f.light_view_projection * vec4(p, 1.0);
    vec3 ndc = clip.xyz / clip.w;
    vec2 uv = ndc.xy * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0))) || any(greaterThan(uv, vec2(1))) || ndc.z > 1.0) return 1.0;
    float blocker = textureLod(sampler2D(astral_textures[pc.shadow], astral_samplers[ASTRAL_SAMPLER_NEAREST_CLAMP]), uv, 0).r;
    return ndc.z - 0.0005 <= blocker ? 1.0 : 0.0;
}

void main() {
    uvec2 xy = gl_GlobalInvocationID.xy;
    if (xy.x >= pc.width || xy.y >= pc.height) return;
    Frame f = pc.frame.f;
    vec2 uv = (vec2(xy) + 0.5) / vec2(pc.width, pc.height);
    vec3 ray = normalize(reconstruct_world(f, uv, 1.0) - f.camera_position.xyz);
    float mu = dot(ray, -f.sun_direction.xyz);
    const float g = 0.45;
    float phase = 0.07957747 * (1.0 - g * g) / pow(1.0 + g * g - 2.0 * g * mu, 1.5);
    vec3 ambient = max(f.sky_color.rgb * f.sky_color.a, vec3(0));
    vec3 sun = max(f.sun_color.rgb, vec3(0)) * phase;
    vec3 scatter = vec3(0);
    float visibility = 1.0;
    float previous = 0.0;
    for (uint i = 0; i < FOG_SLICES; ++i) {
        float t = float(i + 1u) / float(FOG_SLICES);
        float distance_m = f.fog.y * t * t;
        vec3 p = f.camera_position.xyz + ray * ((previous + distance_m) * 0.5);
        float optical_depth = f.fog.x * (distance_m - previous);
        vec3 tinted_depth = vec3(optical_depth);
        for (uint v = 0u; v < pc.count; ++v) {
            SmokeVolume volume = pc.volumes.data[v];
            vec4 local = volume.extinction * occupied_length(volume, f.camera_position.xyz, ray, previous, distance_m);
            optical_depth += local.a;
            tinted_depth += local.rgb;
        }
        float segment = exp(-optical_depth);
        scatter += visibility * (1.0 - segment) * (ambient + sun * sun_visibility(f, p)) * (tinted_depth / max(optical_depth, 1e-8));
        visibility *= segment;
        imageStore(astral_storage_images[pc.atlas], ivec2(xy.x, xy.y + i * pc.height), vec4(scatter, visibility));
        previous = distance_m;
    }
}
