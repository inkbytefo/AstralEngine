#version 460
#include <astral/scene.glsl>
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant, scalar) uniform Push {
    FrameRef frame;
    uint atlas, shadow, width, height;
} pc;

float sun_visibility(Frame f, vec3 p) {
    if (pc.shadow == NO_TEXTURE) return 1.0;
    vec4 clip = f.light_view_projection * vec4(p, 1.0);
    vec3 ndc = clip.xyz / clip.w;
    vec2 uv = ndc.xy * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0))) || any(greaterThan(uv, vec2(1))) || ndc.z > 1.0) return 1.0;
    float blocker = textureLod(sampler2D(astral_textures[pc.shadow], astral_samplers[ASTRAL_SAMPLER_NEAREST_CLAMP]), uv, 0).r;
    return ndc.z - 0.0005 <= blocker ? 1.0 : 0.0;
}

void main() {
    uvec2 xy = gl_GlobalInvocationID.xy;
    if (xy.x >= pc.width || xy.y >= pc.height) return;
    Frame f = pc.frame.f;
    vec2 uv = (vec2(xy) + 0.5) / vec2(pc.width, pc.height);
    vec3 ray = normalize(reconstruct_world(f, uv, 1.0) - f.camera_position.xyz);
    float mu = dot(ray, -f.sun_direction.xyz);
    const float g = 0.45;
    float phase = 0.07957747 * (1.0 - g * g) / pow(1.0 + g * g - 2.0 * g * mu, 1.5);
    vec3 ambient = max(f.sky_color.rgb * f.sky_color.a, vec3(0));
    vec3 sun = max(f.sun_color.rgb, vec3(0)) * phase;
    vec3 scatter = vec3(0);
    float visibility = 1.0;
    float previous = 0.0;
    for (uint i = 0; i < FOG_SLICES; ++i) {
        float t = float(i + 1u) / float(FOG_SLICES);
        float distance_m = f.fog.y * t * t;
        vec3 p = f.camera_position.xyz + ray * ((previous + distance_m) * 0.5);
        float segment = exp(-f.fog.x * (distance_m - previous));
        scatter += visibility * (1.0 - segment) * (ambient + sun * sun_visibility(f, p));
        visibility *= segment;
        imageStore(astral_storage_images[pc.atlas], ivec2(xy.x, xy.y + i * pc.height), vec4(scatter, visibility));
        previous = distance_m;
    }
}
