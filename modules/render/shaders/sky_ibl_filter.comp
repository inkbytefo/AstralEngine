#version 460
#include <astral/sky_ibl.glsl>
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant, scalar) uniform Push {
    uint radiance, filtered, width, slice_height;
} pc;

vec3 sky_tangent(vec3 n, vec3 v) {
    vec3 up = abs(n.y) < 0.98 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(up, n));
    return tangent * v.x + cross(n, tangent) * v.y + n * v.z;
}

void main() {
    uvec2 xy = gl_GlobalInvocationID.xy;
    uint layer = xy.y / pc.slice_height;
    if (xy.x >= pc.width || layer > SKY_SPECULAR_LEVELS) return;
    vec2 uv = (vec2(xy.x, xy.y % pc.slice_height) + 0.5) / vec2(pc.width, pc.slice_height);
    vec3 n = sky_direction(uv);
    bool diffuse = layer == SKY_SPECULAR_LEVELS;
    float roughness = float(layer) / float(SKY_SPECULAR_LEVELS - 1u);
    if (layer == 0u) {
        imageStore(astral_storage_images[pc.filtered], ivec2(xy), vec4(sky_environment_sample(pc.radiance, n), 1));
        return;
    }
    float a2 = pow(roughness, 4.0);
    vec3 sum = vec3(0);
    float weights = 0.0;
    const uint count = 64u;
    for (uint i = 0u; i < count; ++i) {
        float phi = 2.0 * SKY_PI * (float(i) + 0.5) / float(count);
        float xi = (float(bitfieldReverse(i)) + 0.5) * 2.3283064365386963e-10;
        float cos_theta = diffuse ? sqrt(1.0 - xi) : sqrt((1.0 - xi) / (1.0 + (a2 - 1.0) * xi));
        float sine = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
        vec3 h = sky_tangent(n, vec3(cos(phi) * sine, sin(phi) * sine, cos_theta));
        vec3 direction = diffuse ? h : reflect(-n, h);
        float w = diffuse ? 1.0 : max(dot(n, direction), 0.0);
        if (w > 0.0) {
            sum += w * sky_environment_sample(pc.radiance, direction);
            weights += w;
        }
    }
    imageStore(astral_storage_images[pc.filtered], ivec2(xy), vec4(sum / max(weights, 1e-5), 1));
}
