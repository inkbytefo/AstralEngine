#version 460
#include <astral/primary.glsl>
#include <astral/restir.glsl>
// Per pixel: direct light with ray-traced visibility (sun cone; local point + rect lights via
// spatiotemporal ReSTIR DI or direct/RIS), near-field GI falling back to DDGI, and one Heitz VNDF
// reflection ray (unbiased demodulated) outputting hit distance in specular.a for virtual reprojection.
layout(push_constant, scalar) uniform Push {
    FrameRef frame; uint64_t tlas; Instances instances; Materials materials; PointLights lights; RectLights rects; SdfShapes shapes;
    Reservoirs reservoirs;
    GBufferIds g; uint irr; uint dist;
    uint out_diffuse; uint out_specular; uint out_geometry; float near_gi_radius;
} pc;
layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    Frame f = pc.frame.f;
    astral_rt_begin(f, pc.instances, pc.materials);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(f.screen.x) || pixel.y >= int(f.screen.y)) return;
    Surface s;
    float depth;
    if (!load_primary(f, pc.g, pixel, s, depth) || s.unshaded) {
        imageStore(astral_storage_images[pc.out_diffuse], pixel, vec4(0));
        imageStore(astral_storage_images[pc.out_specular], pixel, vec4(0));
        imageStore(astral_storage_images[pc.out_geometry], pixel, vec4(0, 0, 0, -1));
        return;
    }
    uint sdf_count = f.counts.y;
    LightingInputs li = LightingInputs(pc.tlas, pc.shapes, sdf_count, pc.lights, pc.rects);
    vec3 v = normalize(f.camera_position.xyz - s.p);
    if (dot(s.n, v) < 0.0) s.n = normalize(s.n - v * (dot(s.n, v) * 1.01)); // normals facing away from the camera
    s.ng = s.n;
    uint seed = make_seed(uvec2(pixel), f.rt_counts.y, 1u);

    vec3 diffuse, specular_direct;
    direct_light(f, li, s, v, true, seed, diffuse, specular_direct);
    if ((f.counts.w & 1u) != 0u) {
        Reservoir r = pc.reservoirs.data[uint(pixel.y) * uint(f.screen.x) + uint(pixel.x)];
        if (r.W > 0.0 && r.light_id != RESTIR_EMPTY_LIGHT) {
            vec3 rd, rsp;
            if (restir_eval_sample(f, pc.lights, pc.rects, s, v, r.light_id, r.uv_packed, rd, rsp)) {
                diffuse += rd * r.W;
                specular_direct += rsp * r.W;
            }
        }
    }

    // Pre-integrated specular reflectance: computed once and reused for diffuse kd and specular demodulation.
    vec3 f0 = mix(vec3(0.04), s.albedo, s.metallic);
    float nv = max(dot(s.n, v), 1e-4);
    vec3 dfg_raw = env_brdf(f0, s.roughness, nv);
    vec3 dfg = max(dfg_raw, vec3(1e-3));
    vec3 kd = (1.0 - dfg_raw) * (1.0 - s.metallic);

    // Indirect diffuse. Near field: one cosine-weighted ray; only query DDGI when the ray escapes.
    vec3 origin = primary_ray_origin(f, s.p, s.n);
    vec3 indirect;
    bool near_hit = false;
    if (pc.near_gi_radius > 0.0) {
        vec2 u = r2(f.rt_counts.y + 17u, seed);
        float r = sqrt(u.x), phi = 2.0 * PI * u.y;
        vec3 dir = to_world(vec3(r * cos(phi), r * sin(phi), sqrt(max(0.0, 1.0 - u.x))), s.n);
        TraceHit nh = trace(pc.tlas, pc.shapes, sdf_count, origin, dir, pc.near_gi_radius);
        if (nh.hit) {
            near_hit = true;
            Surface hs = nh.sdf ? sdf_surface(pc.shapes, sdf_count, origin, dir, nh.t)
                                : triangle_surface(pc.instances, pc.materials, nh.instance, nh.prim, nh.bary, origin, dir, nh.t);
            indirect = hs.backface ? vec3(0) : shade_secondary(f, li, hs, -dir, pc.irr, pc.dist, true, seed);
        }
    }
    if (!near_hit) {
        indirect = ddgi_irradiance(f, pc.irr, pc.dist, s.p, s.n, v);
    }
    diffuse += indirect * kd;

    // Reflection: Heitz VNDF sample (exact mirror for roughness < 0.04), unbiasedly demodulated by dfg.
    float a = max(s.roughness * s.roughness, 0.002);
    vec3 l;
    vec3 h_vec = s.n;
    vec3 spec_weight = vec3(0.0);
    bool is_mirror = s.roughness < ASTRAL_MIRROR_ROUGHNESS;
    if (is_mirror) {
        l = reflect(-v, s.n);
        spec_weight = fresnel_schlick(f0, nv) / dfg;
    } else {
        vec3 t = tangent_of(s.n), b = cross(s.n, t);
        vec3 v_local = vec3(dot(v, t), dot(v, b), dot(v, s.n));
        vec2 u = r2(f.rt_counts.y, seed);
        vec3 h_local = sample_vndf(v_local, a, u);
        h_vec = normalize(t * h_local.x + b * h_local.y + s.n * h_local.z);
        l = reflect(-v, h_vec);
        float nl = dot(s.n, l);
        float vh = max(dot(v, h_vec), 0.0);
        if (nl > 0.0) {
            spec_weight = fresnel_schlick(f0, vh) * smith_vndf_weight(nv, nl, a) / dfg;
        }
    }
    vec3 reflected = vec3(0);
    float spec_hit_t = 0.0; // >0: hit distance, -1: sky/infinite miss, 0: no reflection ray traced
    if (dot(s.n, l) > 0.0 && any(greaterThan(spec_weight, vec3(0.0)))) {
        TraceHit h = trace(pc.tlas, pc.shapes, sdf_count, origin, l, f.rt_params.w);
        float hit_t = h.hit ? h.t : 1e30;
        float rect_t = 1e30;
        uint rect_idx = 0u;
        vec3 rect_radiance = vec3(0);
        for (uint i = 0u; i < f.rt_counts.x; ++i) {
            RectLight r = pc.rects.data[i];
            float t = intersect_rect(r, origin, l);
            if (t > 0.0 && t < rect_t) { rect_t = t; rect_idx = i; rect_radiance = r.radiance.rgb; }
        }
        if (rect_t < hit_t) {
            spec_hit_t = min(rect_t, 60000.0);
            float w_mis = 1.0;
            if (!is_mirror) {
                RectLight rl = pc.rects.data[rect_idx];
                vec3 ln = cross(rl.right.xyz, rl.up.xyz);
                float area = 4.0 * length(ln);
                float cos_l = abs(dot(normalize(ln), -l));
                float prob = rect_light_select_prob(f, pc.rects, rect_idx, s.p, s.n);
                float pdf_light = prob * (rect_t * rect_t) / max(area * cos_l, 1e-8);
                float pdf_brdf = vndf_reflection_pdf(nv, max(dot(s.n, h_vec), 0.0), a);
                w_mis = mis_power2(pdf_brdf, pdf_light);
            }
            reflected = rect_radiance * w_mis;
        } else if (h.hit) {
            spec_hit_t = min(h.t, 60000.0);
            Surface hs = h.sdf ? sdf_surface(pc.shapes, sdf_count, origin, l, h.t)
                               : triangle_surface(pc.instances, pc.materials, h.instance, h.prim, h.bary, origin, l, h.t);
            reflected = hs.backface ? vec3(0) : shade_secondary(f, li, hs, -l, pc.irr, pc.dist, true, seed);
        } else {
            spec_hit_t = -1.0;
            reflected = sky_radiance(f, l);
        }
        reflected *= spec_weight;
    }
    // Demodulate: composite multiplies by env_brdf(f0, roughness, nv) again.
    vec3 specular = reflected + specular_direct / dfg;

    // Clamp fireflies (rare high-energy samples) before they enter the temporal history.
    specular = min(specular, vec3(64.0));
    diffuse = min(diffuse, vec3(64.0));
    // A single bad sample must never poison the temporal history.
    if (any(isnan(diffuse)) || any(isinf(diffuse))) diffuse = vec3(0);
    if (any(isnan(specular)) || any(isinf(specular))) specular = vec3(0);
    imageStore(astral_storage_images[pc.out_diffuse], pixel, vec4(diffuse, 1));
    imageStore(astral_storage_images[pc.out_specular], pixel, vec4(specular, spec_hit_t));
    imageStore(astral_storage_images[pc.out_geometry], pixel, vec4(s.n, length(f.camera_position.xyz - s.p)));
}
