#version 460
#include <astral/primary.glsl>
#include <astral/restir.glsl>
// ReSTIR DI Pass 1: initial candidate RIS + visibility reuse + temporal reservoir reuse.
// Generates RESTIR_INIT_CANDIDATES stratified candidates over point & rect lights, traces 1 visibility
// ray on the selected candidate before temporal reuse, and validates any accepted temporal winner in
// the current frame so every reservoir entering spatial reuse is strictly visible at its owning pixel.
layout(push_constant, scalar) uniform Push {
    FrameRef frame; Reservoirs prev_reservoirs; Reservoirs out_reservoirs;
    GBufferIds g; uint prev_geometry; uint pass_index;
} pc;
layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    Frame f = pc.frame.f;
    Instances scene_instances = Instances(f.scene_instances);
    Materials scene_materials = Materials(f.scene_materials);
    PointLights scene_lights = PointLights(f.scene_lights);
    RectLights scene_rects = RectLights(f.scene_rects);
    SdfShapes scene_shapes = SdfShapes(f.scene_shapes);
    astral_rt_begin(f, scene_instances, scene_materials);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size_i = ivec2(f.screen.xy);
    if (pixel.x >= size_i.x || pixel.y >= size_i.y) return;
    uint out_idx = uint(pixel.y) * uint(size_i.x) + uint(pixel.x);

    Surface s;
    float depth;
    if (!load_primary(f, pc.g, pixel, s, depth) || s.unshaded) {
        pc.out_reservoirs.data[out_idx] = Reservoir(RESTIR_EMPTY_LIGHT, 0u, 0.0, 0u);
        return;
    }
    vec3 v = normalize(f.camera_position.xyz - s.p);
    if (dot(s.n, v) < 0.0) s.n = normalize(s.n - v * (dot(s.n, v) * 1.01));
    s.ng = s.n;

    uint pt_count = f.counts.x;
    uint rect_count = f.rt_counts.x;
    if (pt_count + rect_count == 0u) {
        pc.out_reservoirs.data[out_idx] = Reservoir(RESTIR_EMPTY_LIGHT, 0u, 0.0, 0u);
        return;
    }

    uint seed = make_seed(uvec2(pixel), f.rt_counts.y, 23u);
    LightingInputs li = LightingInputs(f.scene_tlas, scene_shapes, f.counts.y, scene_lights, scene_rects);

    // 1. Initial candidate generation via RIS over stratified point + rect lights.
    float p_rect = restir_rect_prob(pt_count, rect_count);
    uint init_id = RESTIR_EMPTY_LIGHT;
    uint init_uv = 0u;
    float init_phat = 0.0;
    float init_wsum = 0.0;
    for (uint k = 0u; k < RESTIR_INIT_CANDIDATES; ++k) {
        uint cid;
        float p_src;
        if (rnd(seed) < p_rect) {
            uint idx = min(uint(rnd(seed) * float(rect_count)), rect_count - 1u);
            cid = RESTIR_RECT_BIT | idx;
            p_src = p_rect / float(rect_count);
        } else {
            uint idx = min(uint(rnd(seed) * float(pt_count)), pt_count - 1u);
            cid = idx;
            p_src = (1.0 - p_rect) / float(pt_count);
        }
        uint cuv = packUnorm2x16(vec2(rnd(seed), rnd(seed)));
        float phat = restir_target_pdf(f, scene_lights, scene_rects, s, v, cid, cuv);
        float w = phat / max(p_src, 1e-8);
        init_wsum += w;
        if (w > 0.0 && rnd(seed) * init_wsum < w) {
            init_id = cid;
            init_uv = cuv;
            init_phat = phat;
        }
    }
    float init_W = (init_phat > 0.0) ? restir_sanitize_weight(init_wsum / (float(RESTIR_INIT_CANDIDATES) * init_phat)) : 0.0;

    // 2. Visibility reuse on initial candidate before temporal/spatial combination.
    if (init_W > 0.0 && !restir_visible(f, li, s, init_id, init_uv)) {
        init_W = 0.0;
    }

    // 3. Temporal reuse with previous-frame geometry & plane-distance validation.
    uint out_id = init_id;
    uint out_uv = init_uv;
    float out_W = init_W;
    uint out_M = 1u;

    if ((f.counts.w & 2u) != 0u) {
        vec2 uv_prev = (vec2(pixel) + 0.5) * f.screen.zw - primary_velocity(f, pc.g, pixel);
        if (all(greaterThanEqual(uv_prev, vec2(0.0))) && all(lessThanEqual(uv_prev, vec2(1.0)))) {
            ivec2 prev_px = clamp(ivec2(floor(uv_prev * f.screen.xy)), ivec2(0), size_i - 1);
            vec4 pg = fetch_texel(pc.prev_geometry, prev_px);
            float expected_prev_dist = length(f.prev_camera_position.xyz - s.p);
            bool geom_ok = pg.w >= 0.0 && dot(pg.xyz, s.n) > 0.9 &&
                           abs(pg.w - expected_prev_dist) < 0.05 * expected_prev_dist + 0.02;
            if (geom_ok) {
                Reservoir rp = pc.prev_reservoirs.data[uint(prev_px.y) * uint(size_i.x) + uint(prev_px.x)];
                uint m_prev = min(rp.M, RESTIR_MAX_TEMPORAL_M);
                if (m_prev > 0u) {
                    float phat_prev = rp.W > 0.0
                        ? restir_target_pdf(f, scene_lights, scene_rects, s, v, rp.light_id, rp.uv_packed)
                        : 0.0;
                    float w0 = init_phat * init_W; // M_init == 1
                    float w1 = float(m_prev) * phat_prev * rp.W;
                    float wsum = w0 + w1;
                    bool pick_prev = (w1 > 0.0) && (rnd(seed) * wsum < w1);
                    uint win_id = pick_prev ? rp.light_id : init_id;
                    uint win_uv = pick_prev ? rp.uv_packed : init_uv;
                    float win_phat = pick_prev ? phat_prev : init_phat;
                    out_M = 1u + m_prev;
                    if (wsum > 0.0 && win_phat > 0.0) {
                        out_id = win_id;
                        out_uv = win_uv;
                        out_W = restir_sanitize_weight(wsum / (float(out_M) * win_phat));
                    } else {
                        out_id = RESTIR_EMPTY_LIGHT;
                        out_W = 0.0;
                    }
                }
            }
        }
    }

    pc.out_reservoirs.data[out_idx] = Reservoir(out_id, out_uv, out_W, out_M);
}
