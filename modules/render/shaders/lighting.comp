#version 460
#include <astral/sdf.glsl>
#include <astral/brdf.glsl>
// Deferred PBR lighting (raster path). Picks the nearer of the mesh and SDF surfaces per pixel.
layout(push_constant, scalar) uniform Push {
    FrameRef frame; PointLights lights; SdfShapes shapes;
    uint albedo; uint normal; uint emissive; uint depth;
    uint sdf_albedo; uint sdf_normal; uint sdf_depth; uint out_hdr;
} pc;
layout(local_size_x = 8, local_size_y = 8) in;

vec4 fetch(uint index, ivec2 p) {
    return texelFetch(sampler2D(astral_textures[index], astral_samplers[ASTRAL_SAMPLER_NEAREST_CLAMP]), p, 0);
}

float shadow_map(Frame f, vec3 world, vec3 n, vec3 to_light) {
    if (f.counts.z == 0xFFFFFFFFu) return 1.0;
    // Normal offset of ~1.5 shadow texels in world space (sun_direction.w) keeps acne away
    // without detaching shadows, whatever the scene size.
    float normal_offset = f.sun_direction.w;
    float slope = 1.0 - clamp(dot(n, to_light), 0.0, 1.0);
    vec3 biased = world + n * normal_offset * (1.0 + 2.0 * slope);
    vec4 clip = f.light_view_projection * vec4(biased, 1.0);
    vec3 ndc = clip.xyz / clip.w;
    vec2 uv = ndc.xy * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))) || ndc.z > 1.0) return 1.0;
    ivec2 size = textureSize(sampler2D(astral_textures[f.counts.z], astral_samplers[ASTRAL_SAMPLER_NEAREST_CLAMP]), 0);
    vec2 texel = uv * vec2(size);
    float lit = 0.0;
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x) {
            float stored = fetch(f.counts.z, clamp(ivec2(texel) + ivec2(x, y), ivec2(0), size - 1)).r;
            lit += ndc.z - 0.0005 <= stored ? 1.0 : 0.0;
        }
    return lit / 9.0;
}

void main() {
    Frame f = pc.frame.f;
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(f.screen.x) || pixel.y >= int(f.screen.y)) return;
    vec2 uv = (vec2(pixel) + 0.5) * f.screen.zw;

    float depth = fetch(pc.depth, pixel).r;
    vec4 albedo_r = fetch(pc.albedo, pixel);
    vec4 normal_m = fetch(pc.normal, pixel);
    vec4 emissive_u = fetch(pc.emissive, pixel);
    uint sdf_count = f.counts.y;
    if (sdf_count > 0u) {
        float sd = fetch(pc.sdf_depth, pixel).r;
        if (sd < depth) {
            depth = sd;
            albedo_r = fetch(pc.sdf_albedo, pixel);
            normal_m = fetch(pc.sdf_normal, pixel);
            emissive_u = vec4(0.0, 0.0, 0.0, 1.0);
        }
    }

    vec3 color;
    if (depth >= 1.0) {
        vec3 dir = normalize(reconstruct_world(f, uv, 1.0) - f.camera_position.xyz);
        color = sky_radiance(f, dir);
    } else if (emissive_u.a > 1.5) {
        color = emissive_u.rgb;
    } else {
        vec3 p = reconstruct_world(f, uv, depth);
        vec3 n = normalize(normal_m.xyz);
        vec3 v = normalize(f.camera_position.xyz - p);
        vec3 albedo = albedo_r.rgb;
        float roughness = clamp(albedo_r.a, ASTRAL_MIN_ROUGHNESS, 1.0), metallic = normal_m.w;

        vec3 l = -normalize(f.sun_direction.xyz);
        float shade = shadow_map(f, p, n, l);
        if (sdf_count > 0u && shade > 0.0 && dot(n, l) > 0.0) {
            shade *= sdf_soft_shadow(pc.shapes, sdf_count, p + n * 0.01, l, 50.0);
        }
        color = eval_direct_pbr(n, v, l, albedo, roughness, metallic) * f.sun_color.rgb * shade;

        for (uint i = 0u; i < f.counts.x; ++i) {
            PointLight light = pc.lights.data[i];
            vec3 to = light.position_radius.xyz - p;
            float dist = max(length(to), 1e-4);
            float radius = max(light.position_radius.w, 1e-4);
            if (dist >= radius) continue;
            float falloff = clamp(1.0 - pow(dist / radius, 4.0), 0.0, 1.0);
            falloff = falloff * falloff / (dist * dist + 1.0);
            color += eval_direct_pbr(n, v, to / dist, albedo, roughness, metallic) * light.color_intensity.rgb *
                     light.color_intensity.a * falloff;
        }
        // Ambient: diffuse from the sky/ground hemisphere, specular from the sky in the reflected
        // direction weighted by split-sum DFG (consistent with the ray-traced path's env_brdf).
        float nv = max(dot(n, v), 1e-4);
        vec3 f0 = mix(vec3(0.04), albedo, metallic);
        vec3 dfg = env_brdf(f0, roughness, nv);
        vec3 diffuse_ambient = mix(f.ground_color.rgb, f.sky_color.rgb, n.y * 0.5 + 0.5) * albedo * (1.0 - metallic);
        vec3 reflected = sky_radiance(f, reflect(-v, n));
        vec3 specular_ambient = mix(reflected, mix(f.ground_color.rgb, f.sky_color.rgb, 0.5), roughness) * dfg;
        color += (diffuse_ambient * (1.0 - dfg) + specular_ambient) * f.sky_color.a + emissive_u.rgb;
    }
    imageStore(astral_storage_images[pc.out_hdr], pixel, vec4(color, 1.0));
}
