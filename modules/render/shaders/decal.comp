#version 460
#include <astral/primary.glsl>
// Deferred box-projected decal pass (M13 / ADR-0033): blends oriented box decals onto mesh G-buffer
// surfaces (albedo, roughness, metallic, normal, and water-film wetness clearcoat).
layout(push_constant, scalar) uniform Push {
    FrameRef frame;
    GBufferIds g;
    uint out_albedo; uint out_normal; uint out_emissive; uint out_material_ext;
} pc;
layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    Frame f = pc.frame.f;
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(f.screen.x) || pixel.y >= int(f.screen.y)) return;

    vec4 albedo_r = fetch_texel(pc.g.albedo, pixel);
    vec4 normal_m = fetch_texel(pc.g.normal, pixel);
    vec4 emissive_u = fetch_texel(pc.g.emissive, pixel);
    vec4 mat_ext = fetch_texel(pc.g.material_ext, pixel);
    float depth = fetch_texel(pc.g.depth, pixel).r;

    uint model = decode_shading_model(emissive_u.a);
    if (depth < 1.0 && model != SHADING_UNSHADED && f.decal_count > 0u) {
        vec2 uv = (vec2(pixel) + 0.5) * f.screen.zw;
        vec3 world = reconstruct_world(f, uv, depth);
        float nlen = length(normal_m.xyz);
        vec3 n = nlen > 1e-6 ? normal_m.xyz / nlen : vec3(0.0, 1.0, 0.0);
        vec3 albedo = albedo_r.rgb;
        float roughness = clamp(albedo_r.a, ASTRAL_MIN_ROUGHNESS, 1.0);
        float metallic = normal_m.w;

        Decals decals = Decals(f.scene_decals);
        for (uint i = 0u; i < f.decal_count; ++i) {
            Decal dec = decals.data[i];
            vec3 local = (dec.inv_transform * vec4(world, 1.0)).xyz;
            if (any(greaterThan(abs(local), vec3(0.5)))) continue;
            float angle = dot(n, dec.axis_up.xyz);
            if (angle <= 0.25) continue;
            vec2 duv = local.xz + 0.5;
            vec4 col = dec.color;
            if (dec.textures.x != NO_TEXTURE) {
                col *= textureLod(sampler2D(astral_textures[nonuniformEXT(dec.textures.x)],
                                            astral_samplers[ASTRAL_SAMPLER_LINEAR_CLAMP]), duv, 0.0);
            }
            float edge = min(min(0.5 - abs(local.x), 0.5 - abs(local.z)), 0.5 - abs(local.y));
            float fade = smoothstep(0.0, 0.05, edge) * smoothstep(0.25, 0.55, angle) * clamp(col.a, 0.0, 1.0);
            if (fade <= 1e-4) continue;

            albedo = mix(albedo, col.rgb, fade);
            if (dec.axis_up.w > 0.5) {
                roughness = mix(roughness, clamp(dec.params.x, ASTRAL_MIN_ROUGHNESS, 1.0), fade);
                metallic = mix(metallic, clamp(dec.params.y, 0.0, 1.0), fade);
            }
            if (dec.textures.y != NO_TEXTURE && dec.params.w > 1e-4) {
                vec2 nxy = textureLod(sampler2D(astral_textures[nonuniformEXT(dec.textures.y)],
                                                astral_samplers[ASTRAL_SAMPLER_LINEAR_CLAMP]), duv, 0.0).xy * 2.0 - 1.0;
                vec3 t = bsdf_default_tangent(n, 0.0);
                vec3 b = cross(n, t);
                vec3 dn = normalize(t * (nxy.x * dec.params.w) + b * (nxy.y * dec.params.w) + n);
                n = normalize(mix(n, dn, fade));
            }
            if (dec.params.z > 1e-4) {
                float coat = model == SHADING_CLEARCOAT ? mat_ext.x : 0.0;
                float coat_r = model == SHADING_CLEARCOAT ? mat_ext.y : 0.1;
                astral_apply_wetness(albedo, roughness, coat, coat_r, metallic, dec.params.z * fade);
                if (coat > 1e-4 && (model == SHADING_STANDARD || model == SHADING_CLEARCOAT)) {
                    model = SHADING_CLEARCOAT;
                    mat_ext = vec4(coat, coat_r, 0.0, 0.0);
                }
            }
        }
        albedo_r = vec4(albedo, roughness);
        normal_m = vec4(n, metallic);
        emissive_u.a = float(model + 1u);
    }

    imageStore(astral_storage_images[pc.out_albedo], pixel, albedo_r);
    imageStore(astral_storage_images[pc.out_normal], pixel, normal_m);
    imageStore(astral_storage_images[pc.out_emissive], pixel, emissive_u);
    imageStore(astral_storage_images[pc.out_material_ext], pixel, mat_ext);
}
