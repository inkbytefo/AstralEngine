#version 460
#include <astral/primary.glsl>
// Temporal anti-aliasing: the projection is jittered every frame (Halton 2,3); history is
// reprojected by depth, sampled with a Catmull-Rom filter, and clipped to the current pixel
// neighbourhood's colour distribution (YCoCg variance clipping) to avoid ghosting.
layout(push_constant, scalar) uniform Push {
    FrameRef frame; GBufferIds g; uint hdr; uint history; uint out_color; float blend;
} pc;
layout(local_size_x = 8, local_size_y = 8) in;

vec3 to_ycocg(vec3 c) {
    return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b, 0.5 * c.r - 0.5 * c.b, -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}
vec3 from_ycocg(vec3 c) { return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z); }
// Compress HDR before filtering so bright pixels do not dominate (Karis).
vec3 compress(vec3 c) { return c / (1.0 + max(c.r, max(c.g, c.b))); }
vec3 uncompress(vec3 c) { return c / max(1.0 - max(c.r, max(c.g, c.b)), 1e-4); }

vec3 sample_history(vec2 uv, vec2 size) {
    // 5-tap Catmull-Rom (bilinear-optimised).
    vec2 pos = uv * size;
    vec2 center = floor(pos - 0.5) + 0.5;
    vec2 fr = pos - center;
    vec2 w0 = fr * (-0.5 + fr * (1.0 - 0.5 * fr));
    vec2 w1 = 1.0 + fr * fr * (-2.5 + 1.5 * fr);
    vec2 w2 = fr * (0.5 + fr * (2.0 - 1.5 * fr));
    vec2 w3 = fr * fr * (-0.5 + 0.5 * fr);
    vec2 w12 = w1 + w2;
    vec2 tc12 = (center + w2 / w12) / size;
    vec2 tc0 = (center - 1.0) / size;
    vec2 tc3 = (center + 2.0) / size;
    vec3 c = astral_sample(pc.history, ASTRAL_SAMPLER_LINEAR_CLAMP, vec2(tc12.x, tc0.y)).rgb * (w12.x * w0.y) +
             astral_sample(pc.history, ASTRAL_SAMPLER_LINEAR_CLAMP, vec2(tc0.x, tc12.y)).rgb * (w0.x * w12.y) +
             astral_sample(pc.history, ASTRAL_SAMPLER_LINEAR_CLAMP, tc12).rgb * (w12.x * w12.y) +
             astral_sample(pc.history, ASTRAL_SAMPLER_LINEAR_CLAMP, vec2(tc3.x, tc12.y)).rgb * (w3.x * w12.y) +
             astral_sample(pc.history, ASTRAL_SAMPLER_LINEAR_CLAMP, vec2(tc12.x, tc3.y)).rgb * (w12.x * w3.y);
    float wsum = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    return max(c / wsum, vec3(0));
}

void main() {
    Frame f = pc.frame.f;
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(f.screen.xy);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    vec3 current = fetch_texel(pc.hdr, pixel).rgb;
    if (f.rt_counts.z == 0u) {
        imageStore(astral_storage_images[pc.out_color], pixel, vec4(current, 1));
        return;
    }
    // Neighbourhood statistics; nearest depth in 3x3 for reprojection (keeps edges crisp).
    vec3 m1 = vec3(0), m2 = vec3(0);
    float nearest = 1.0;
    ivec2 nearest_px = pixel;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 q = clamp(pixel + ivec2(x, y), ivec2(0), size - 1);
            vec3 c = to_ycocg(compress(fetch_texel(pc.hdr, q).rgb));
            m1 += c;
            m2 += c * c;
            float d = fetch_texel(pc.g.depth, q).r;
            if (f.counts.y > 0u) d = min(d, fetch_texel(pc.g.sdf_depth, q).r);
            if (d < nearest) { nearest = d; nearest_px = q; }
        }
    }
    vec3 mean = m1 / 9.0;
    vec3 sigma = sqrt(max(m2 / 9.0 - mean * mean, 0.0));
    vec2 uv_now = (vec2(nearest_px) + 0.5) * f.screen.zw;
    vec2 uv;
    if (nearest < 1.0) {
        // Motion of the nearest surface in the 3x3 (keeps moving edges crisp).
        uv = uv_now - primary_velocity(f, pc.g, nearest_px);
    } else if (!reproject(f, f.camera_position.xyz + camera_ray(f, nearest_px) * 1e4, uv)) {
        imageStore(astral_storage_images[pc.out_color], pixel, vec4(current, 1));
        return;
    }
    if (any(lessThan(uv, vec2(0))) || any(greaterThan(uv, vec2(1)))) {
        imageStore(astral_storage_images[pc.out_color], pixel, vec4(current, 1));
        return;
    }
    uv += (vec2(pixel) - vec2(nearest_px)) * f.screen.zw;
    vec3 history = to_ycocg(compress(sample_history(uv, f.screen.xy)));
    // Clip the history toward the neighbourhood mean (AABB of mean ± γσ).
    vec3 lo = mean - 1.25 * sigma, hi = mean + 1.25 * sigma;
    vec3 center = 0.5 * (lo + hi), extent = 0.5 * (hi - lo) + 1e-5;
    vec3 offset = history - center;
    vec3 units = abs(offset / extent);
    float m = max(units.x, max(units.y, units.z));
    if (m > 1.0) history = center + offset / m;
    vec3 now = to_ycocg(compress(current));
    vec3 result = mix(history, now, pc.blend);
    imageStore(astral_storage_images[pc.out_color], pixel, vec4(uncompress(from_ycocg(result)), 1));
}
