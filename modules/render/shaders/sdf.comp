#version 460
#include <astral/sdf.glsl>
// Raymarches the SDF scene for every pixel, stopping at the mesh depth, and writes a small
// G-buffer of its own. Lighting composites it with the mesh G-buffer by depth.
layout(push_constant, scalar) uniform Push {
    FrameRef frame; SdfShapes shapes;
    uint mesh_depth; uint out_albedo; uint out_normal; uint out_depth; uint out_velocity;
} pc;
layout(local_size_x = 8, local_size_y = 8) in;
void main() {
    Frame f = pc.frame.f;
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(f.screen.x) || pixel.y >= int(f.screen.y)) return;
    vec2 uv = (vec2(pixel) + 0.5) * f.screen.zw;
    float mesh_d = texelFetch(sampler2D(astral_textures[pc.mesh_depth], astral_samplers[ASTRAL_SAMPLER_NEAREST_CLAMP]), pixel, 0).r;

    vec3 origin = f.camera_position.xyz;
    vec3 far_point = reconstruct_world(f, uv, mesh_d < 1.0 ? mesh_d : 1.0);
    vec3 dir = normalize(far_point - origin);
    float t_max = mesh_d < 1.0 ? length(far_point - origin) : 1000.0;

    uint count = f.counts.y;
    // A camera inside the SDF would "hit" at distance 0 everywhere: treat the solid as
    // transparent from inside instead (the player passing through a blob sees out).
    bool inside = sdf_distance(pc.shapes, count, origin) < 0.0;
    float t = 0.0;
    bool hit = false;
    float d = 1e9;
    for (int i = 0; i < 160 && t < t_max && !inside; ++i) {
        d = sdf_distance(pc.shapes, count, origin + dir * t);
        if (d < 0.0005 * max(t, 1.0)) { hit = true; break; }
        t += d;
    }
    // Rays that ran out of steps while grazing a surface still count as hits (no silhouette holes).
    if (!hit && !inside && t < t_max && d < 0.01 * max(t, 1.0)) hit = true;
    float depth = 1.0;
    if (hit && t < t_max) {
        vec3 p = origin + dir * t;
        SdfHit h = sdf_scene(pc.shapes, count, p);
        vec3 n = sdf_normal(pc.shapes, count, p, 0.001 * max(t, 1.0));
        vec4 clip = f.view_projection * vec4(p, 1.0);
        depth = clamp(clip.z / clip.w, 0.0, 1.0);
        imageStore(astral_storage_images[pc.out_albedo], pixel, vec4(h.albedo, h.roughness));
        imageStore(astral_storage_images[pc.out_normal], pixel, vec4(n, h.metallic));
        // SDF shapes are static between frames: only the camera moves them on screen.
        vec4 now = f.unjittered_view_projection * vec4(p, 1.0);
        vec4 prev = f.prev_view_projection * vec4(p, 1.0);
        vec2 velocity = compute_velocity(now, prev);
        imageStore(astral_storage_images[pc.out_velocity], pixel, vec4(velocity, 0, 0));
    }
    imageStore(astral_storage_images[pc.out_depth], pixel, vec4(depth));
}
