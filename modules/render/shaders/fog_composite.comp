#version 460
#include <astral/scene.glsl>
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant, scalar) uniform Push {
    FrameRef frame;
    uint hdr, depth, sdf_depth, atlas, result;
} pc;

vec4 fetch_fog(uint index, ivec2 p) {
    return texelFetch(sampler2D(astral_textures[index], astral_samplers[ASTRAL_SAMPLER_NEAREST_CLAMP]), p, 0);
}

void main() {
    Frame f = pc.frame.f;
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(f.screen.xy)))) return;
    vec2 uv = (vec2(pixel) + 0.5) * f.screen.zw;
    float depth = fetch_fog(pc.depth, pixel).r;
    if (pc.sdf_depth != NO_TEXTURE) depth = min(depth, fetch_fog(pc.sdf_depth, pixel).r);
    float distance_m = depth < 1.0 ? length(reconstruct_world(f, uv, depth) - f.camera_position.xyz) : f.fog.y;
    vec4 medium = fog_sample(f, pc.atlas, uv, distance_m);
    vec4 hdr = fetch_fog(pc.hdr, pixel);
    imageStore(astral_storage_images[pc.result], pixel, vec4(hdr.rgb * medium.a + medium.rgb, hdr.a));
}
