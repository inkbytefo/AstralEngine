#version 460
#extension GL_GOOGLE_include_directive : require

// HDR -> display. Exposure, ACES (Narkowicz fit) and sRGB encoding into an RGBA8 image.
// Debug views are passed through untouched.

layout(local_size_x = 8, local_size_y = 8) in;

#include "include/Common.glsl"

layout(set = 0, binding = 0) uniform FrameUBO { FrameData frame; };
layout(set = 0, binding = 1) uniform sampler2D hdr;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D outImage;

vec3 Aces(vec3 x) {
    return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
}

vec3 LinearToSrgb(vec3 c) {
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(frame.viewport.x) || pixel.y >= int(frame.viewport.y)) return;
    vec3 c = texelFetch(hdr, pixel, 0).rgb;
    if (frame.counts.z == DEBUG_NONE) c = Aces(c * frame.envParams.y);
    imageStore(outImage, pixel, vec4(LinearToSrgb(clamp(c, 0.0, 1.0)), 1.0));
}
