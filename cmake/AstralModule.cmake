include(GNUInstallDirs)

# astral_add_module(NAME <name> SOURCES <src...> [DEPS <Astral::X...>] [PRIVATE_DEPS <...>])
#   Creates static library astral_<name> with alias Astral::<Name>.
#   Public headers live in modules/<name>/include/astral/<name>/.
#   DEPS are PUBLIC (part of the API), PRIVATE_DEPS stay hidden (third-party libs).
function(astral_add_module)
    cmake_parse_arguments(ARG "" "NAME" "SOURCES;DEPS;PRIVATE_DEPS" ${ARGN})
    set(target astral_${ARG_NAME})
    string(SUBSTRING ${ARG_NAME} 0 1 first)
    string(TOUPPER ${first} first)
    string(SUBSTRING ${ARG_NAME} 1 -1 rest)
    set(export_name "${first}${rest}")

    add_library(${target} STATIC ${ARG_SOURCES})
    add_library(Astral::${export_name} ALIAS ${target})
    set_target_properties(${target} PROPERTIES
        EXPORT_NAME ${export_name}
        ASTRAL_MODULE_NAME "${ARG_NAME}"
        ASTRAL_MODULE_ALIAS "Astral::${export_name}"
        ASTRAL_MODULE_DEPS "${ARG_DEPS}"
        ASTRAL_MODULE_PRIVATE_DEPS "${ARG_PRIVATE_DEPS}")
    target_compile_features(${target} PUBLIC cxx_std_20)
    target_include_directories(${target}
        PUBLIC  $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
                $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
        PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/src)
    if(ARG_DEPS)
        target_link_libraries(${target} PUBLIC ${ARG_DEPS})
    endif()
    if(ARG_PRIVATE_DEPS)
        target_link_libraries(${target} PRIVATE ${ARG_PRIVATE_DEPS})
    endif()
    astral_set_warnings(${target})
    set_property(GLOBAL APPEND PROPERTY ASTRAL_MODULES ${target})
    if(ASTRAL_INSTALL)
        install(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/include/ DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
    endif()
endfunction()

# astral_add_tests(MODULE <name> SOURCES <src...>)
#   Builds astral_<name>_tests (doctest) and registers it with ctest.
function(astral_add_tests)
    cmake_parse_arguments(ARG "" "MODULE" "SOURCES" ${ARGN})
    if(NOT ASTRAL_BUILD_TESTS)
        return()
    endif()
    set(target astral_${ARG_MODULE}_tests)
    add_executable(${target} ${ARG_SOURCES})
    target_link_libraries(${target} PRIVATE astral_${ARG_MODULE} doctest::doctest)
    astral_set_warnings(${target})
    add_test(NAME ${target} COMMAND ${target})
    set_tests_properties(${target} PROPERTIES TIMEOUT 120)
endfunction()

function(_astral_json_quote value out_var)
    set(escaped "${value}")
    string(REPLACE "\\" "\\\\" escaped "${escaped}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    set(${out_var} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

function(_astral_unwrap_genex item out_var)
    set(val "${item}")
    set(changed TRUE)
    while(changed)
        set(changed FALSE)
        if(val MATCHES "^\\$<[A-Z0-9_]+:(.+)>$")
            set(val "${CMAKE_MATCH_1}")
            set(changed TRUE)
        elseif(val MATCHES "^\\$<\\$<[^>]+>:(.+)>$")
            set(val "${CMAKE_MATCH_1}")
            set(changed TRUE)
        endif()
    endwhile()
    set(${out_var} "${val}" PARENT_SCOPE)
endfunction()

function(_astral_json_string_array items out_var)
    set(arr "[]")
    foreach(item IN LISTS items)
        _astral_json_quote("${item}" quoted)
        string(JSON arr_len LENGTH "${arr}")
        string(JSON arr SET "${arr}" ${arr_len} "${quoted}")
    endforeach()
    set(${out_var} "${arr}" PARENT_SCOPE)
endfunction()

# astral_export_module_graph(<output_file>)
#   Exports every module registered via astral_add_module() and its declared internal dependencies
#   (from DEPS, PRIVATE_DEPS, and configured LINK_LIBRARIES / INTERFACE_LINK_LIBRARIES properties)
#   as JSON at configure time. Third-party system targets are ignored; unrecognized Astral:: or
#   astral_* references are preserved verbatim so layer_check rejects them.
function(astral_export_module_graph output_file)
    get_property(modules GLOBAL PROPERTY ASTRAL_MODULES)

    set(known_names "")
    set(known_targets "")
    set(known_aliases "")
    foreach(target IN LISTS modules)
        get_target_property(mod_name ${target} ASTRAL_MODULE_NAME)
        get_target_property(mod_alias ${target} ASTRAL_MODULE_ALIAS)
        list(APPEND known_names "${mod_name}")
        list(APPEND known_targets "${target}")
        list(APPEND known_aliases "${mod_alias}")
    endforeach()

    set(modules_json "[]")
    foreach(target IN LISTS modules)
        get_target_property(mod_name ${target} ASTRAL_MODULE_NAME)
        get_target_property(mod_alias ${target} ASTRAL_MODULE_ALIAS)
        get_target_property(declared_public ${target} ASTRAL_MODULE_DEPS)
        get_target_property(declared_private ${target} ASTRAL_MODULE_PRIVATE_DEPS)
        get_target_property(iface_links ${target} INTERFACE_LINK_LIBRARIES)
        get_target_property(priv_links ${target} LINK_LIBRARIES)

        set(raw_public "")
        if(declared_public)
            list(APPEND raw_public ${declared_public})
        endif()
        set(extra_private "")
        if(iface_links)
            foreach(item IN LISTS iface_links)
                if(item MATCHES "^\\$<LINK_ONLY:(.+)>$")
                    list(APPEND extra_private "${CMAKE_MATCH_1}")
                elseif(NOT item IN_LIST raw_public)
                    list(APPEND raw_public "${item}")
                endif()
            endforeach()
        endif()

        set(raw_private "")
        if(declared_private)
            list(APPEND raw_private ${declared_private})
        endif()
        if(priv_links)
            foreach(item IN LISTS priv_links)
                if(NOT item IN_LIST raw_public AND NOT item IN_LIST raw_private)
                    list(APPEND raw_private "${item}")
                endif()
            endforeach()
        endif()
        if(extra_private)
            foreach(item IN LISTS extra_private)
                if(NOT item IN_LIST raw_public AND NOT item IN_LIST raw_private)
                    list(APPEND raw_private "${item}")
                endif()
            endforeach()
        endif()

        set(public_deps "")
        foreach(item IN LISTS raw_public)
            _astral_unwrap_genex("${item}" dep)
            set(resolved "")
            list(FIND known_aliases "${dep}" idx)
            if(NOT idx EQUAL -1)
                list(GET known_names ${idx} resolved)
            else()
                list(FIND known_targets "${dep}" idx)
                if(NOT idx EQUAL -1)
                    list(GET known_names ${idx} resolved)
                else()
                    string(TOLOWER "${dep}" dep_lower)
                    if(dep_lower MATCHES "astral::" OR dep_lower MATCHES "^astral_")
                        set(resolved "${dep}")
                    endif()
                endif()
            endif()
            if(resolved AND NOT resolved IN_LIST public_deps)
                list(APPEND public_deps "${resolved}")
            endif()
        endforeach()

        set(private_deps "")
        foreach(item IN LISTS raw_private)
            _astral_unwrap_genex("${item}" dep)
            set(resolved "")
            list(FIND known_aliases "${dep}" idx)
            if(NOT idx EQUAL -1)
                list(GET known_names ${idx} resolved)
            else()
                list(FIND known_targets "${dep}" idx)
                if(NOT idx EQUAL -1)
                    list(GET known_names ${idx} resolved)
                else()
                    string(TOLOWER "${dep}" dep_lower)
                    if(dep_lower MATCHES "astral::" OR dep_lower MATCHES "^astral_")
                        set(resolved "${dep}")
                    endif()
                endif()
            endif()
            if(resolved AND NOT resolved IN_LIST private_deps)
                list(APPEND private_deps "${resolved}")
            endif()
        endforeach()

        _astral_json_quote("${mod_name}" name_q)
        _astral_json_quote("${target}" target_q)
        _astral_json_quote("${mod_alias}" alias_q)
        _astral_json_string_array("${public_deps}" pub_json)
        _astral_json_string_array("${private_deps}" priv_json)

        set(entry "{}")
        string(JSON entry SET "${entry}" name "${name_q}")
        string(JSON entry SET "${entry}" target "${target_q}")
        string(JSON entry SET "${entry}" alias "${alias_q}")
        string(JSON entry SET "${entry}" public_deps "${pub_json}")
        string(JSON entry SET "${entry}" private_deps "${priv_json}")

        string(JSON mod_len LENGTH "${modules_json}")
        string(JSON modules_json SET "${modules_json}" ${mod_len} "${entry}")
    endforeach()

    set(doc "{}")
    string(JSON doc SET "${doc}" schema_version 1)
    string(JSON doc SET "${doc}" modules "${modules_json}")
    set(content "${doc}\n")

    set(existing "")
    if(EXISTS "${output_file}")
        file(READ "${output_file}" existing)
    endif()
    if(NOT existing STREQUAL content)
        file(WRITE "${output_file}" "${content}")
    endif()
endfunction()
