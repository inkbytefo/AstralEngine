@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if("Gpu" IN_LIST Astral_FIND_COMPONENTS)
    find_dependency(Vulkan 1.3)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AstralTargets.cmake")

# Every requested component must map to an installed Astral::<Component> target.
foreach(component IN LISTS Astral_FIND_COMPONENTS)
    if(TARGET Astral::${component})
        set(Astral_${component}_FOUND TRUE)
    else()
        set(Astral_${component}_FOUND FALSE)
    endif()
endforeach()

check_required_components(Astral)
