@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
# Static modules carry their private dependencies into the link line.
find_dependency(Vulkan 1.3)
find_dependency(SDL3 CONFIG)
find_dependency(Jolt CONFIG)
find_dependency(glslang CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/AstralTargets.cmake")

# Shader helper for consumers: astral_add_shaders(<target> SOURCES ...).
set_and_check(ASTRAL_GPU_SHADER_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/astral/shaders")
include("${CMAKE_CURRENT_LIST_DIR}/AstralShaders.cmake")
# Game helper: astral_add_game(<name> SOURCES ... ASSETS <folder>) — exe + cook + .apak.
include("${CMAKE_CURRENT_LIST_DIR}/AstralGame.cmake")

# Every requested component must map to an installed Astral::<Component> target.
foreach(component IN LISTS Astral_FIND_COMPONENTS)
    if(TARGET Astral::${component})
        set(Astral_${component}_FOUND TRUE)
    else()
        set(Astral_${component}_FOUND FALSE)
    endif()
endforeach()

check_required_components(Astral)
