# Script mode: turns a list of .spv files into a C++ source with a lookup table.
#   cmake -DOUTPUT=<file.cpp> -DINPUTS=<a.spv;b.spv> -P EmbedShaders.cmake
set(body "// Generated by cmake/EmbedShaders.cmake. Do not edit.\n#include <cstdint>\n#include <span>\n#include <string_view>\n\nnamespace Astral::Render::Detail {\nnamespace {\n")
set(table "")
set(index 0)
foreach(spv ${INPUTS})
    get_filename_component(name ${spv} NAME)
    string(REGEX REPLACE "\\.spv$" "" name ${name})
    file(READ ${spv} hex HEX)
    string(LENGTH "${hex}" hex_len)
    # 8 hex chars per 32-bit word, little endian on disk.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])" "0x\\4\\3\\2\\1u," words "${hex}")
    string(APPEND body "const uint32_t kShader${index}[] = {${words}};\n")
    string(APPEND table "    {\"${name}\", kShader${index}},\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND body "struct Entry { std::string_view name; std::span<const uint32_t> code; };\nconst Entry kEntries[] = {\n${table}};\n} // namespace\n\n")
string(APPEND body "std::span<const uint32_t> FindEmbeddedShader(std::string_view name) {\n    for (const Entry& e : kEntries)\n        if (e.name == name) return e.code;\n    return {};\n}\n\n} // namespace Astral::Render::Detail\n")
file(WRITE ${OUTPUT} "${body}")
