# cmake -DCTEST=<ctest> -DBUILD_DIR=<build folder> -P CheckTestEnvironment.cmake
# Fails unless every registered test points the SPIR-V cache into the build folder (ASTRAL_SHADER_CACHE),
# so running the suite never writes shader caches into the user's profile.
execute_process(COMMAND "${CTEST}" --show-only=json-v1 --test-dir "${BUILD_DIR}"
                OUTPUT_VARIABLE json RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "ctest --show-only failed: ${err}")
endif()
string(JSON count LENGTH "${json}" tests)
if(count EQUAL 0)
    message(FATAL_ERROR "no tests registered")
endif()
set(missing "")
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    string(JSON name GET "${json}" tests ${i} name)
    set(found FALSE)
    string(JSON props ERROR_VARIABLE no_props GET "${json}" tests ${i} properties)
    if(NOT no_props)
        string(JSON nprops LENGTH "${props}")
        if(nprops GREATER 0)
            math(EXPR plast "${nprops} - 1")
            foreach(p RANGE ${plast})
                string(JSON pname GET "${props}" ${p} name)
                if(pname STREQUAL "ENVIRONMENT_MODIFICATION" OR pname STREQUAL "ENVIRONMENT")
                    string(JSON pvalue GET "${props}" ${p} value)
                    if(pvalue MATCHES "ASTRAL_SHADER_CACHE=")
                        set(found TRUE)
                    endif()
                endif()
            endforeach()
        endif()
    endif()
    if(NOT found)
        list(APPEND missing "${name}")
    endif()
endforeach()
if(missing)
    list(LENGTH missing n)
    list(JOIN missing ", " names)
    message(FATAL_ERROR "${n} of ${count} tests do not set ASTRAL_SHADER_CACHE: ${names}")
endif()
message(STATUS "ASTRAL_SHADER_CACHE set for all ${count} tests")
